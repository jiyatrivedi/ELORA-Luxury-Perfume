# ============================================================
#  ELORA — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# Flask secret key (change to a long random string in production)
ELORA_SECRET_KEY=elora-dev-secret-change-in-prod

# ---- Gmail SMTP settings ----
# Use a Gmail App Password — NOT your normal Gmail password.
# How to create one:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select app: "Mail", device: "Other" → type "ELORA"
#   5. Copy the generated 16-character password (no spaces) here.

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password_here
